/* =========================================
   HOTVAGE.COM
   Main JavaScript
========================================= */

document.addEventListener("DOMContentLoaded", function () {

    /* =========================================
       MOBILE MENU
    ========================================= */

    const menuButton = document.querySelector(".menu-button");

    if (menuButton) {
        menuButton.addEventListener("click", function () {
            document.body.classList.toggle("menu-open");
        });
    }


    /* =========================================
       SEARCH BUTTON
    ========================================= */

    const searchButton = document.querySelector(".search-button");

    if (searchButton) {
        searchButton.addEventListener("click", function () {

            const searchTerm = window.prompt(
                "What video are you looking for?"
            );

            if (searchTerm && searchTerm.trim() !== "") {

                const query = encodeURIComponent(
                    searchTerm.trim()
                );

                window.location.href =
                    "pages/search.html?q=" + query;
            }

        });
    }


    /* =========================================
       TIME FILTER
    ========================================= */

    const timeFilter =
        document.querySelector(".time-filter");

    if (timeFilter) {

        timeFilter.addEventListener("change", function () {

            const selectedValue = this.value;

            /*
             * Backend/database filtering will be
             * connected later.
             */

            console.log(
                "Selected video filter:",
                selectedValue
            );

        });
    }


    /* =========================================
       LOAD MORE BUTTON
    ========================================= */

    const loadMoreButton =
        document.querySelector(".load-more-button");

    if (loadMoreButton) {

        loadMoreButton.addEventListener("click", function () {

            /*
             * Real videos will be loaded from
             * PHP/MySQL later.
             */

            this.textContent = "Loading...";

            setTimeout(() => {

                this.textContent = "More Videos Coming Soon";

                this.disabled = true;

            }, 700);

        });
    }


    /* =========================================
       VIDEO CARD CLICK
    ========================================= */

    const videoCards =
        document.querySelectorAll(".video-card");

    videoCards.forEach(function (card) {

        card.addEventListener("keydown", function (event) {

            if (event.key === "Enter") {

                const link =
                    card.querySelector(".video-thumbnail");

                if (link) {
                    link.click();
                }

            }

        });

    });


    /* =========================================
       HORIZONTAL SCROLL WITH MOUSE WHEEL
    ========================================= */

    const horizontalAreas =
        document.querySelectorAll(
            ".navigation-scroll, .trending-scroll"
        );

    horizontalAreas.forEach(function (area) {

        area.addEventListener(
            "wheel",
            function (event) {

                if (window.innerWidth <= 900) {

                    if (Math.abs(event.deltaY) >
                        Math.abs(event.deltaX)) {

                        area.scrollLeft += event.deltaY;

                    }

                }

            },
            { passive: true }
        );

    });


    /* =========================================
       PREVENT EMPTY LINKS
    ========================================= */

    const emptyLinks =
        document.querySelectorAll('a[href="#"]');

    emptyLinks.forEach(function (link) {

        link.addEventListener("click", function (event) {

            event.preventDefault();

        });

    });


    /* =========================================
       CURRENT YEAR
    ========================================= */

    const yearElements =
        document.querySelectorAll(".current-year");

    yearElements.forEach(function (element) {

        element.textContent =
            new Date().getFullYear();

    });

    /* =========================================
   GLOBAL VIDEO AD GATE
========================================= */

const VIDEO_AD_URL = "YOUR_AD_LINK_HERE";

function openVideoAd() {

    const adShown =
        sessionStorage.getItem("hotvage_ad_shown");

    if (!adShown) {

        sessionStorage.setItem(
            "hotvage_ad_shown",
            "true"
        );

        if (
            VIDEO_AD_URL &&
            VIDEO_AD_URL !== "YOUR_AD_LINK_HERE"
        ) {
            window.open(
                VIDEO_AD_URL,
                "_blank",
                "noopener,noreferrer"
            );
        }

        return false;
    }

    return true;
}

    /* =========================================
       AUTO SVG PREVIEW BUTTON
    ========================================= */

    function createPreviewSVG() {

        const svgNS =
            "http://www.w3.org/2000/svg";

        const svg =
            document.createElementNS(
                svgNS,
                "svg"
            );

        svg.setAttribute(
            "class",
            "preview-play-svg"
        );

        svg.setAttribute(
            "viewBox",
            "0 0 100 100"
        );

        svg.setAttribute(
            "aria-hidden",
            "true"
        );

        svg.setAttribute(
            "focusable",
            "false"
        );


        const outerCircle =
            document.createElementNS(
                svgNS,
                "circle"
            );

        outerCircle.setAttribute(
            "cx",
            "50"
        );

        outerCircle.setAttribute(
            "cy",
            "50"
        );

        outerCircle.setAttribute(
            "r",
            "43"
        );

        outerCircle.setAttribute(
            "fill",
            "rgba(255,255,255,0.78)"
        );

        outerCircle.setAttribute(
            "stroke",
            "rgba(255,255,255,0.95)"
        );

        outerCircle.setAttribute(
            "stroke-width",
            "3"
        );


        const playPath =
            document.createElementNS(
                svgNS,
                "path"
            );

        playPath.setAttribute(
            "d",
            "M42 32 L42 68 L70 50 Z"
        );

        playPath.setAttribute(
            "fill",
            "#111111"
        );


        const innerCircle =
            document.createElementNS(
                svgNS,
                "circle"
            );

        innerCircle.setAttribute(
            "cx",
            "50"
        );

        innerCircle.setAttribute(
            "cy",
            "50"
        );

        innerCircle.setAttribute(
            "r",
            "47"
        );

        innerCircle.setAttribute(
            "fill",
            "none"
        );

        innerCircle.setAttribute(
            "stroke",
            "rgba(255,255,255,0.35)"
        );

        innerCircle.setAttribute(
            "stroke-width",
            "2"
        );


        svg.appendChild(outerCircle);
        svg.appendChild(playPath);
        svg.appendChild(innerCircle);

        return svg;
    }


    /* =========================================
       AUTOMATICALLY ADD SVG TO ALL
       PREVIEW BUTTONS
    ========================================= */

    function setupPreviewButtons() {

        const buttons =
            document.querySelectorAll(
                ".play-overlay"
            );

        buttons.forEach(function (button) {

            if (
                !button.querySelector(
                    ".preview-play-svg"
                )
            ) {

                button.innerHTML = "";

                button.appendChild(
                    createPreviewSVG()
                );

            }

        });

    }


    setupPreviewButtons();


    /* =========================================
       PREVIEW BUTTON + GLOBAL AD GATE
    ========================================= */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    ".play-overlay"
                );

            if (!button) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();


            const adCanContinue =
                openVideoAd();


            if (!adCanContinue) {
                return;
            }


            /* Second click:
               Preview will be connected
               to the video player system.
            */

            console.log(
                "Video Preview Started"
            );

        },
        true
    );
});