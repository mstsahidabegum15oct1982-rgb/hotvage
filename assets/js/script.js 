/* =========================================
   HOTVAGE.COM
   Main JavaScript
========================================= */

document.addEventListener("DOMContentLoaded", function () {

    /* =========================================
       MOBILE MENU
    ========================================= */

    const menuButton = document.querySelector(".menu-button");

    if (menuButton) {
        menuButton.addEventListener("click", function () {
            document.body.classList.toggle("menu-open");
        });
    }


    /* =========================================
       SEARCH BUTTON
    ========================================= */

    const searchButton = document.querySelector(".search-button");

    if (searchButton) {
        searchButton.addEventListener("click", function () {

            const searchTerm = window.prompt(
                "What video are you looking for?"
            );

            if (searchTerm && searchTerm.trim() !== "") {

                const query = encodeURIComponent(
                    searchTerm.trim()
                );

                window.location.href =
                    "pages/search.html?q=" + query;
            }

        });
    }


    /* =========================================
       TIME FILTER
    ========================================= */

    const timeFilter =
        document.querySelector(".time-filter");

    if (timeFilter) {

        timeFilter.addEventListener("change", function () {

            const selectedValue = this.value;

            /*
             * Backend/database filtering will be
             * connected later.
             */

            console.log(
                "Selected video filter:",
                selectedValue
            );

        });
    }


    /* =========================================
       LOAD MORE BUTTON
    ========================================= */

    const loadMoreButton =
        document.querySelector(".load-more-button");

    if (loadMoreButton) {

        loadMoreButton.addEventListener("click", function () {

            /*
             * Real videos will be loaded from
             * PHP/MySQL later.
             */

            this.textContent = "Loading...";

            setTimeout(() => {

                this.textContent = "More Videos Coming Soon";

                this.disabled = true;

            }, 700);

        });
    }


    /* =========================================
       VIDEO CARD CLICK
    ========================================= */

    const videoCards =
        document.querySelectorAll(".video-card");

    videoCards.forEach(function (card) {

        card.addEventListener("keydown", function (event) {

            if (event.key === "Enter") {

                const link =
                    card.querySelector(".video-thumbnail");

                if (link) {
                    link.click();
                }

            }

        });

    });


    /* =========================================
       HORIZONTAL SCROLL WITH MOUSE WHEEL
    ========================================= */

    const horizontalAreas =
        document.querySelectorAll(
            ".navigation-scroll, .trending-scroll"
        );

    horizontalAreas.forEach(function (area) {

        area.addEventListener(
            "wheel",
            function (event) {

                if (window.innerWidth <= 900) {

                    if (Math.abs(event.deltaY) >
                        Math.abs(event.deltaX)) {

                        area.scrollLeft += event.deltaY;

                    }

                }

            },
            { passive: true }
        );

    });


    /* =========================================
       PREVENT EMPTY LINKS
    ========================================= */

    const emptyLinks =
        document.querySelectorAll('a[href="#"]');

    emptyLinks.forEach(function (link) {

        link.addEventListener("click", function (event) {

            event.preventDefault();

        });

    });


    /* =========================================
       CURRENT YEAR
    ========================================= */

    const yearElements =
        document.querySelectorAll(".current-year");

    yearElements.forEach(function (element) {

        element.textContent =
            new Date().getFullYear();

    });

    /* =========================================
   GLOBAL VIDEO AD GATE
========================================= */

const VIDEO_AD_URL = "YOUR_AD_LINK_HERE";

function openVideoAd() {

    const adShown =
        sessionStorage.getItem("hotvage_ad_shown");

    if (!adShown) {

        sessionStorage.setItem(
            "hotvage_ad_shown",
            "true"
        );

        if (
            VIDEO_AD_URL &&
            VIDEO_AD_URL !== "YOUR_AD_LINK_HERE"
        ) {
            window.open(
                VIDEO_AD_URL,
                "_blank",
                "noopener,noreferrer"
            );
        }

        return false;
    }

    return true;
}

        /* =========================================
       AUTO FINGER / TAP PREVIEW BUTTON
       Automatically created by JavaScript
    ========================================= */

    function createPreviewSVG() {

        const svgNS =
            "http://www.w3.org/2000/svg";

        const svg =
            document.createElementNS(
                svgNS,
                "svg"
            );

        svg.setAttribute(
            "class",
            "preview-play-svg"
        );

        svg.setAttribute(
            "viewBox",
            "0 0 100 100"
        );

        svg.setAttribute(
            "aria-hidden",
            "true"
        );

        svg.setAttribute(
            "focusable",
            "false"
        );


        /* =====================================
           OUTER CIRCLE
        ===================================== */

        const circle =
            document.createElementNS(
                svgNS,
                "circle"
            );

        circle.setAttribute(
            "cx",
            "50"
        );

        circle.setAttribute(
            "cy",
            "50"
        );

        circle.setAttribute(
            "r",
            "44"
        );

        circle.setAttribute(
            "fill",
            "rgba(255,255,255,0.80)"
        );

        circle.setAttribute(
            "stroke",
            "rgba(255,255,255,0.95)"
        );

        circle.setAttribute(
            "stroke-width",
            "2"
        );


        /* =====================================
           FINGER / HAND ICON
        ===================================== */

        const finger =
            document.createElementNS(
                svgNS,
                "path"
            );

        finger.setAttribute(
            "d",
            "M43 68 C40 65 39 61 40 57 L43 39 C43.5 36 46 34 48.5 35 C51 36 52 38 52 41 L51 53 L55 45 C56 42.5 58.5 41.5 60.5 43 C62.5 44 63 46 62 48.5 L59 57 C63 56 67 57.5 69 60.5 C71 64 70 69 67 73 C64 77 59 80 53 80 C48 80 45 76 43 68 Z"
        );

        finger.setAttribute(
            "fill",
            "#111111"
        );


        /* =====================================
           TAP RIPPLE
        ===================================== */

        const ripple =
            document.createElementNS(
                svgNS,
                "circle"
            );

        ripple.setAttribute(
            "cx",
            "50"
        );

        ripple.setAttribute(
            "cy",
            "27"
        );

        ripple.setAttribute(
            "r",
            "6"
        );

        ripple.setAttribute(
            "fill",
            "none"
        );

        ripple.setAttribute(
            "stroke",
            "#111111"
        );

        ripple.setAttribute(
            "stroke-width",
            "3"
        );


        /* =====================================
           TAP RIPPLE LEFT
        ===================================== */

        const rippleLeft =
            document.createElementNS(
                svgNS,
                "path"
            );

        rippleLeft.setAttribute(
            "d",
            "M36 27 C36 22 39 18 43 16"
        );

        rippleLeft.setAttribute(
            "fill",
            "none"
        );

        rippleLeft.setAttribute(
            "stroke",
            "#111111"
        );

        rippleLeft.setAttribute(
            "stroke-width",
            "3"
        );

        rippleLeft.setAttribute(
            "stroke-linecap",
            "round"
        );


        /* =====================================
           TAP RIPPLE RIGHT
        ===================================== */

        const rippleRight =
            document.createElementNS(
                svgNS,
                "path"
            );

        rippleRight.setAttribute(
            "d",
            "M64 27 C64 22 61 18 57 16"
        );

        rippleRight.setAttribute(
            "fill",
            "none"
        );

        rippleRight.setAttribute(
            "stroke",
            "#111111"
        );

        rippleRight.setAttribute(
            "stroke-width",
            "3"
        );

        rippleRight.setAttribute(
            "stroke-linecap",
            "round"
        );


        /* =====================================
           ADD SVG ELEMENTS
        ===================================== */

        svg.appendChild(circle);

        svg.appendChild(ripple);

        svg.appendChild(rippleLeft);

        svg.appendChild(rippleRight);

        svg.appendChild(finger);


        return svg;
    }


    /* =========================================
       AUTOMATICALLY ADD FINGER BUTTON
       TO ALL VIDEO PREVIEW BUTTONS
    ========================================= */

    function setupPreviewButtons() {

        const buttons =
            document.querySelectorAll(
                ".play-overlay"
            );

        buttons.forEach(function (button) {

            if (
                !button.querySelector(
                    ".preview-play-svg"
                )
            ) {

                button.innerHTML = "";

                button.appendChild(
                    createPreviewSVG()
                );

            }

        });

    }


    setupPreviewButtons();


    /* =========================================
       PREVIEW BUTTON + GLOBAL AD GATE
    ========================================= */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    ".play-overlay"
                );

            if (!button) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();


            const adCanContinue =
                openVideoAd();


            if (!adCanContinue) {
                return;
            }


            /* Second click:
               Preview will be connected
               to the video player system.
            */

            console.log(
                "Video Preview Started"
            );

        },

        true
    );

}); 